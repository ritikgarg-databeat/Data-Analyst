# Copy this file to .env and adjust as needed. Never commit the real .env.

# --- Environment ---
ENVIRONMENT=development

# --- PostgreSQL (used by docker-compose to configure the postgres service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=data_analyst_lab
POSTGRES_PORT=5432

# --- Backend API ---
# Full SQLAlchemy URL the API connects with. When running via docker compose,
# host "postgres" resolves to the postgres service; when running the API
# locally (outside Docker) against dockerized Postgres, use "localhost" instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/data_analyst_lab
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Local authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
INITIAL_ADMIN_EMAIL=admin@dataanalyst.com
INITIAL_ADMIN_PASSWORD=admin@dataanalyst
BOOTSTRAP_ADMIN_ON_START=true
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_SIGNUP_ENABLED=true
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_TRUSTED_ORIGIN=http://localhost:3000
AUTH_DEFAULT_AI_QUOTA=25

# --- Frontend ---
WEB_PORT=3000

# --- Python Lab (Phase 4) ---
# Only needed if `${PWD}/data/sample` / `${PWD}/data/datasets` don't resolve
# to your repo's own directories on your platform when running via docker
# compose (a known rough edge on some Windows setups) — see
# docs/architecture.md#python-lab-phase-4. Not needed for local
# (non-Docker) development.
PYTHON_LAB_HOST_DATA_DIR=
PYTHON_LAB_HOST_DATASETS_DIR=

# --- Dataset Hub (Phase 5) ---
# Kaggle dataset search/import. Optional — the rest of the Dataset Hub
# (local import, profiling, EDA, visualization) works fully without these.
# To enable Kaggle:
#   1. Create a free Kaggle account, then go to Settings -> API -> Create New Token.
#   2. This downloads a kaggle.json file containing a username and key.
#   3. Copy those two values below. Never commit your real .env.
#   4. Also install the optional dependency once: `uv sync --project apps/api --extra kaggle`
# Credentials stay server-side and are never sent to the frontend.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Maximum size (in MB) accepted per uploaded dataset file.
DATASET_MAX_UPLOAD_MB=500

# --- AI Layer (Phase 10) ---
# AI is fully optional and off-by-default in the sense that AI_PROVIDER=local
# needs no key at all (a deterministic, template-based fallback — see
# apps/api/app/ai/providers/local_provider.py). Set AI_PROVIDER=openai or
# =anthropic and the matching key below to use a real provider. Never commit
# real keys; these stay server-side and are never sent to the frontend.
AI_PROVIDER=local
AI_MODEL=
AI_API_KEY=
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_DAILY_REQUEST_LIMIT=200
